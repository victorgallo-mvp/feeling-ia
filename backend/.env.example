# Postgres do cérebro (já existe). No Railway, referencie a variável do serviço Postgres.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# Defina como true se conectar pela URL pública do Railway e ela exigir SSL.
PGSSL=false

# Webhooks do n8n (Production URL de cada workflow)
N8N_WEBHOOK_RELATORIO=
N8N_WEBHOOK_PESQUISA=
N8N_WEBHOOK_BRIEFING=
N8N_WEBHOOK_PRESENCA=
N8N_WEBHOOK_INTERNO=
N8N_WEBHOOK_REUNIAO=
# transcrição de gravações (áudio/vídeo) de reunião
N8N_WEBHOOK_TRANSCREVER=
# criativos (imagem assíncrona com callback; copy síncrona)
N8N_WEBHOOK_CRIATIVO_IMAGEM=
N8N_WEBHOOK_CRIATIVO_COPY=
N8N_WEBHOOK_ANEXAR=
# padrão da classificação de conversas (aba Comercial); cada cliente pode ter o seu na ficha
N8N_WEBHOOK_COMERCIAL=

# Onde os PDFs são gravados. No Railway, aponte para um volume (ex.: /data/pdfs).
STORAGE_DIR=./pdfs

# Origens liberadas no CORS, separadas por vírgula (ex.: https://cockpit.vercel.app). Vazio = libera tudo.
CORS_ORIGIN=

PORT=3000
